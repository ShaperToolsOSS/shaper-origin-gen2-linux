/dts-v1/;

#include "imx8mm-blade-1.dtsi"

/ {
	model = "Shaper Origin Gen 2 (SO2) / Davis";

	/* 24V Power from AC/DC on Davis Power Board */
	reg_vsys_24v0: regulator-vsys-24v0 {
		regulator-name = "VSYS_24V0";
		compatible = "regulator-fixed";
		regulator-max-microvolt = <24000000>;
		regulator-min-microvolt = <24000000>;
		regulator-boot-on;
		regulator-always-on;
	};

	/* 5V0 Power from SMPS on Davis Power Board. It is supplied from the 24V AC/DC */
	reg_vsys_5v0: regulator-vsys-5v0 {
		regulator-name = "VSYS_5V0";
		compatible = "regulator-fixed";
		regulator-max-microvolt = <5000000>;
		regulator-min-microvolt = <5000000>;
		regulator-boot-on;
		regulator-always-on;
		vin-supply = <&reg_vsys_24v0>;
	};

	/* Camera AVDD is generated by a fixed regulator on the vision board supplied from the Blade 1's 3.3V Rail */
	reg_camera_avdd: regulator-camera-avdd {
		regulator-name = "VDD_2V8_CAM";
		compatible = "regulator-fixed";
		regulator-max-microvolt = <2800000>;
		regulator-min-microvolt = <2800000>;
		regulator-boot-on;
		regulator-always-on;
		vin-supply = <&reg_pmic_buck4>;
	};

	/* Camera DVDD is generated by a fixed regulator on the vision board supplied from the Blade 1's 3.3V Rail */
	reg_camera_dvdd: regulator-camera-dvdd {
		regulator-name = "VDD_1V2_CAM";
		compatible = "regulator-fixed";
		regulator-max-microvolt = <1200000>;
		regulator-min-microvolt = <1200000>;
		regulator-boot-on;
		regulator-always-on;
		vin-supply = <&reg_pmic_buck4>;
	};

	/* Constant current driver for backlight is derived by 24V AC/DC */
	reg_backlight_power: regulator-backlight-power {
		regulator-name = "VSYS_24V0-BACKLIGHT";
		compatible = "regulator-fixed";
		regulator-max-microvolt = <24000000>;
		regulator-min-microvolt = <24000000>;
		regulator-boot-on;
		regulator-always-on;
		vin-supply = <&reg_vsys_24v0>;
	};

	mipi_backlight: mipi_backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm1 0 20000 0>;
		status = "okay";
		power-supply = <&reg_backlight_power>;
		brightness-levels = < 0 99 >;
		num-interpolated-steps = < 100 >;
	default-brightness-level = <99>;
	};
};

&resmem {
        linux,cma {
                size = <0 0x14000000>;   /* 320 MiB */
        };
};

&ocotp {
	/delete-node/ fec_mac_address;
	fec_mac_address: mac-address@90 { /* 0x640 */
		reg = <0x90 8>; /* align to 32-bit words for nvmem */
	};
};

&pwm1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_mipi_bl>;
	status = "okay";
};

&flexspi {
	status = "disabled";
};

&i2c1 {
	/*
	 * NXP PCF8523 is going EOL, so we expect to switch over to the Renesas ISL1208 RTC
	 * See DAVIS-446
	 * Rev G MLB Fabs move to the Renesas Part
	 * Kernel Probe failure is expected for whichever part is not populated
	 * We could do a userspace probe to only load the correct one based on board ID, but this is fine.
	 * The ISL1208 IRQ is routed to GPIO3_IO00 with an external 1.8V pull-up so we enable it here.
	 */
	rtc@68 {
		compatible = "nxp,pcf8523";
		reg = <0x68>;
	};

	rtc@6f {
		compatible = "isil,isl1208";
		reg = <0x6f>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_rtc_isl1208>;
		interrupt-names = "irq";
		interrupt-parent = <&gpio3>;
		interrupts = <0 IRQ_TYPE_EDGE_FALLING>;
		wakeup-source;
	};

	pca6416_0: gpio@20 {
		compatible = "nxp,pcal6416";
		#gpio-cells = <2>;
		gpio-controller;
		reg = <0x20>;
		interrupt-parent = <&gpio3>;
		interrupts = <7 IRQ_TYPE_EDGE_FALLING>;
		interrupt-controller;
		reset-gpios = <&gpio1 23 GPIO_ACTIVE_LOW>;
		gpio-line-names =
			"MLB_ID_3",
			"MLB_ID_2",
			"MLB_ID_1",
			"MLB_ID_0",
			"PWR_ID_1",
			"PWR_ID_0",
			"LCD_ID_1",
			"LCD_ID_0",
			"Z_ID_1",
			"Z_ID_0",
			"EXP_ID_1",
			"EXP_ID_0",
			"NC_3",
			"NC_2",
			"NC_1",
			"NC_0";
	};
};

&i2c2 {
	touch@5c {
		compatible = "sis,i2c_touch_driver";
		reg = <0x5c>;
		sis,rst-gpio = <&gpio1 16 0>;
		sis,int-gpio = <&gpio1 17 0>;
	};
};

&sema1 {
	status = "ok";
};

/*
 * Keep the 32k clock running for the Murata 1MW BT wake/sleep clock path.
 * Without this, userspace hciattach bring-up is unreliable on Davis.
 */
&clk {
	init-on-array = <IMX8MM_CLK_32K>;
};


/*
&sema1 {
	status = "ok";
};*/

/* GPIO5 is owned exclusively by the M4 Core, and is therefore disabled in the Linux kernel config to prevent lockup due to improper sharing */
&gpio5 {
	status = "disabled";
};

&gpio4 {
	hwspinlock = <3>;
	/delete-property/ interrupt-controller;
	status = "ok";
};

&wdog1 {
	status = "ok";
};

&wdog2 {
	status = "ok";
};

&i2c4 {
	ov9281: ov9281@60 {
		status = "okay";
		compatible = "ovti,ov9281";
		reg = <0x60>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_csi_pwdn>;
		clocks = <&clk IMX8MM_CLK_CLKO2>;
		clock-names = "xvclk";
		assigned-clocks = <&clk IMX8MM_CLK_CLKO2>;
		assigned-clock-parents = <&clk IMX8MM_CLK_24M>;
		assigned-clock-rates = <24000000>;
		csi_id = <0>;
		pwdn-gpio = <&gpio3 14 GPIO_ACTIVE_LOW>;
		mclk = <24000000>;
		mclk_source = <0>;
		avdd-supply = <&reg_camera_avdd>;  /* The Analog Rail of the camera is powered by a regulator on the Camera board. */
		dovdd-supply = <&reg_pmic_buck5>;  /* The Digital I/O Rail of the camera is powered by VDD_1V8 (PMIC BUCK5 Output) */
		dvdd-supply = <&reg_camera_dvdd>;  /* The Digital Core Rail of the camera is powered by a regulator on the Camera board. */
		port {
			ov9281_ep: endpoint {
				remote-endpoint = <&mipi1_sensor_ep>;
				data-lanes = <1 2>;
				link-frequencies = /bits/ 64 <400000000>;
			};
		};
	};
};

&mipi_csi {
	status = "okay";
	/* The MIPI PHY is powered by VDD_MIPI_0P9 (PMIC LDO4 Output) on the Blade 1 SOM
	 * However, the mxc_mipi_csi.c driver is used for used for this, which is also used for the i.MX7
	 * The i.MX7 MIPI Phy voltage is 1.0, whereas it is 0.9V for the i.MX8MM.
	 * The driver tries to set the voltage to 1.0V, which fails as our regulator is configured to allow a max of 0.9V.
	 * Therefore, the following line is left commented out for now, resulting in a "dummy regulator warning" in DMESG.
	 */
	/* mipi-phy-supply = <&reg_pmic_ldo4>; */
	ports {
		port@0 {
			reg = <0>;
			mipi1_sensor_ep: endpoint {
				remote-endpoint = <&ov9281_ep>;
				csis-hs-settle = <13>;
				csis-clk-settle = <2>;
				csis-wclk;
				data-lanes = <1 2>;
			};
		};
	};
};

&csi {
	fsl,mipi-mode;
	dma-coherent;
	status = "okay";
};

&lcdif {
	status = "okay";
};

&mipi_dsi {
	status = "okay";

	/* Output port to the DSI panel */
	port@1 {
		reg = <1>;
		dsim_to_panel: endpoint {
			attach-bridge;
			remote-endpoint = <&panel_in>;
		};
	};

	panel@0 {
		compatible = "ilitek,ili9881c", "shaper,davis-panel";
		reg = <0>;
		power-supply = <&reg_pmic_buck4>;  /* The Display is powered by VDD_3V3 (PMIC BUCK4 Output) */
		backlight = <&mipi_backlight>;
		pinctrl-0 = <&pinctrl_mipi_dsi_en>;
		reset-gpios = <&gpio4 29 GPIO_ACTIVE_LOW>;
		dsi-lanes = <4>;
		video-mode = <2>; /* 0: burst mode
				   * 1: non-burst mode with sync event
				   * 2: non-burst mode with sync pulse
				   */
		panel-width-mm = <68>;
		panel-height-mm = <121>;
		rotation = <90>;
		status = "okay";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				panel_in: endpoint {
					remote-endpoint = <&dsim_to_panel>;
				};
			};
		};
	};
};

&iomuxc {
	pinctrl-names = "default";

	pinctrl_csi_pwdn: csi_pwdn_grp {
		fsl,pins = <
			MX8MM_IOMUXC_NAND_DQS_GPIO3_IO14    0x19
			MX8MM_IOMUXC_GPIO1_IO15_CCMSRCGPCMIX_CLKO2	0x59
		>;
	};

	pinctrl_mipi_dsi_en: mipi_dsi_en {
		fsl,pins = <
			MX8MM_IOMUXC_SAI3_RXC_GPIO4_IO29		0x16
			MX8MM_IOMUXC_SAI1_RXD4_GPIO4_IO6		0x16
		>;
	};

	pinctrl_mipi_bl: mipibacklightgrp {
		fsl,pins = <
			MX8MM_IOMUXC_GPIO1_IO01_PWM1_OUT            0x16
		>;
	};
};

&{/busfreq} {
	/* TF-A build lacks DDR DVFS hooks, so keep busfreq driver disabled */
	status = "disabled";
};
