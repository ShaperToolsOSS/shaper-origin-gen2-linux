/* TODO: We could define GPIO5 names too, but we know that that GPIO5 is fully owned by the M4 in our application, so we don't bother for now. */ 

&iomuxc {
	pinctrl-names = "default";

	pinctrl_usbotg1: usbotg1grp {
		fsl,pins = <
			MX8MM_IOMUXC_GPIO1_IO13_USB1_OTG_OC		0x16
		>;
	};

	pinctrl_reg_usb1_en: regusb1engrp {
		fsl,pins = <
			MX8MM_IOMUXC_GPIO1_IO12_GPIO1_IO12		0x16
		>;
	};

	pinctrl_reg_usb2_en: regusb2engrp {
		fsl,pins = <
			MX8MM_IOMUXC_ENET_TD2_GPIO1_IO19		0x16
		>;
	};

	pinctrl_i2c1: i2c1grp {
		fsl,pins = <
			MX8MM_IOMUXC_I2C1_SCL_I2C1_SCL			0x400000c3
			MX8MM_IOMUXC_I2C1_SDA_I2C1_SDA			0x400000c3
		>;
	};

	pinctrl_rtc_isl1208: rtcisl1208grp {
		fsl,pins = <
			MX8MM_IOMUXC_NAND_ALE_GPIO3_IO0			0x41
		>;
	};

	pinctrl_i2c2: i2c2grp {
		fsl,pins = <
			MX8MM_IOMUXC_I2C2_SCL_I2C2_SCL			0x400000c3
			MX8MM_IOMUXC_I2C2_SDA_I2C2_SDA			0x400000c3
		>;
	};

	pinctrl_i2c3: i2c3grp {
		fsl,pins = <
			MX8MM_IOMUXC_I2C3_SCL_I2C3_SCL			0x400000c3
			MX8MM_IOMUXC_I2C3_SDA_I2C3_SDA			0x400000c3
		>;
	};

	pinctrl_i2c4: i2c4grp {
		fsl,pins = <
			MX8MM_IOMUXC_I2C4_SCL_I2C4_SCL			0x400000c3
			MX8MM_IOMUXC_I2C4_SDA_I2C4_SDA			0x400000c3
		>;
	};

	pinctrl_pmic: pmicirq {
		fsl,pins = <
			MX8MM_IOMUXC_GPIO1_IO03_GPIO1_IO3		0x41
		>;
	};

	pinctrl_reg_usdhc2_vmmc: regusdhc2vmmc {
		fsl,pins = <
			MX8MM_IOMUXC_SD2_RESET_B_GPIO2_IO19		0x41
		>;
	};

	pinctrl_uart1: uart1grp {
		fsl,pins = <
			MX8MM_IOMUXC_SAI2_RXC_UART1_DCE_RX		0x16
			MX8MM_IOMUXC_SAI2_RXFS_UART1_DCE_TX		0x16
			MX8MM_IOMUXC_SAI2_TXFS_UART1_DCE_CTS_B		0x1816
			MX8MM_IOMUXC_SAI2_RXD0_UART1_DCE_RTS_B		0x16
		>;
	};

	pinctrl_uart2: uart2grp {
		fsl,pins = <
			MX8MM_IOMUXC_SAI3_TXFS_UART2_DCE_RX		0x16
			MX8MM_IOMUXC_UART2_TXD_UART2_DCE_TX		0x16
		>;
	};

	pinctrl_wlan: wlangrp {
		fsl,pins = <
			/* SD1 Block is powered by 1.8V Rail, so internal pullups are OK */
			MX8MM_IOMUXC_SD1_DATA7_GPIO2_IO9		0x111  /* WL_HOST_WAKE - Active High Level Interrupt, so we pull it down */
		>;
	};

	pinctrl_wlan_reg_on: wlanregongrp {
		fsl,pins = <
			/* SD1 Block is powered by 1.8V Rail, so internal pullups are OK */
			/* WL_REG_ON is active high; 1MW has ~200K internal pulldown */
			MX8MM_IOMUXC_SD1_RESET_B_GPIO2_IO10		0x1c4  /* WL_REG_ON */
		>;
	};

	pinctrl_bt_gpios: btgpiosgrp {
		fsl,pins = <
			MX8MM_IOMUXC_GPIO1_IO00_ANAMIX_REF_CLK_32K	0x000  /* MCU_CLKOUT_32K */
			/* SD1 Block is powered by 1.8V Rail, so internal pullups are OK */
			/* BT_REG_ON is active high; 1MW has ~200K internal pulldown */
			MX8MM_IOMUXC_SD1_DATA4_GPIO2_IO6		0x1c4  /* BT_REG_ON */
			MX8MM_IOMUXC_SD1_DATA5_GPIO2_IO7		0x16   /* BT_DEV_WAKE (driven high by gpio-hog) */
			MX8MM_IOMUXC_SD1_DATA6_GPIO2_IO8		0x111  /* BT_HOST_WAKE - active high, pulled down */
		>;
	};

	pinctrl_usdhc2_gpio: usdhc2grpgpio {
		fsl,pins = <
			MX8MM_IOMUXC_SD2_CD_B_GPIO2_IO12		0x41
		>;
	};

	pinctrl_usdhc1: usdhc1grp {
		fsl,pins = <
			MX8MM_IOMUXC_SD1_CLK_USDHC1_CLK			0x190
			MX8MM_IOMUXC_SD1_CMD_USDHC1_CMD			0x1d0
			MX8MM_IOMUXC_SD1_DATA0_USDHC1_DATA0		0x1d0
			MX8MM_IOMUXC_SD1_DATA1_USDHC1_DATA1		0x1d0
			MX8MM_IOMUXC_SD1_DATA2_USDHC1_DATA2		0x1d0
			MX8MM_IOMUXC_SD1_DATA3_USDHC1_DATA3		0x1d0
		>;
	};

	pinctrl_usdhc1_100mhz: usdhc1grp100mhz {
		fsl,pins = <
			MX8MM_IOMUXC_SD1_CLK_USDHC1_CLK			0x194
			MX8MM_IOMUXC_SD1_CMD_USDHC1_CMD			0x1d4
			MX8MM_IOMUXC_SD1_DATA0_USDHC1_DATA0		0x1d4
			MX8MM_IOMUXC_SD1_DATA1_USDHC1_DATA1		0x1d4
			MX8MM_IOMUXC_SD1_DATA2_USDHC1_DATA2		0x1d4
			MX8MM_IOMUXC_SD1_DATA3_USDHC1_DATA3		0x1d4
		>;
	};

	pinctrl_usdhc1_200mhz: usdhc1grp200mhz {
		fsl,pins = <
			MX8MM_IOMUXC_SD1_CLK_USDHC1_CLK			0x196
			MX8MM_IOMUXC_SD1_CMD_USDHC1_CMD			0x1d6
			MX8MM_IOMUXC_SD1_DATA0_USDHC1_DATA0		0x1d6
			MX8MM_IOMUXC_SD1_DATA1_USDHC1_DATA1		0x1d6
			MX8MM_IOMUXC_SD1_DATA2_USDHC1_DATA2		0x1d6
			MX8MM_IOMUXC_SD1_DATA3_USDHC1_DATA3		0x1d6
		>;
	};

	pinctrl_usdhc2: usdhc2grp {
		fsl,pins = <
			MX8MM_IOMUXC_SD2_CLK_USDHC2_CLK			0x016
			MX8MM_IOMUXC_SD2_CMD_USDHC2_CMD			0x016
			MX8MM_IOMUXC_SD2_DATA0_USDHC2_DATA0		0x1816
			MX8MM_IOMUXC_SD2_DATA1_USDHC2_DATA1		0x016
			MX8MM_IOMUXC_SD2_DATA2_USDHC2_DATA2		0x016
			MX8MM_IOMUXC_SD2_DATA3_USDHC2_DATA3		0x016
			MX8MM_IOMUXC_GPIO1_IO04_USDHC2_VSELECT		0x0d0
		>;
	};

	pinctrl_usdhc2_100mhz: usdhc2grp100mhz {
		fsl,pins = <
			MX8MM_IOMUXC_SD2_CLK_USDHC2_CLK			0x094
			MX8MM_IOMUXC_SD2_CMD_USDHC2_CMD			0x0d4
			MX8MM_IOMUXC_SD2_DATA0_USDHC2_DATA0		0x0d4
			MX8MM_IOMUXC_SD2_DATA1_USDHC2_DATA1		0x0d4
			MX8MM_IOMUXC_SD2_DATA2_USDHC2_DATA2		0x0d4
			MX8MM_IOMUXC_SD2_DATA3_USDHC2_DATA3		0x0d4
			MX8MM_IOMUXC_GPIO1_IO04_USDHC2_VSELECT		0x0d0
		>;
	};

	pinctrl_usdhc2_200mhz: usdhc2grp200mhz {
		fsl,pins = <
			MX8MM_IOMUXC_SD2_CLK_USDHC2_CLK			0x096
			MX8MM_IOMUXC_SD2_CMD_USDHC2_CMD			0x0d6
			MX8MM_IOMUXC_SD2_DATA0_USDHC2_DATA0		0x0d6
			MX8MM_IOMUXC_SD2_DATA1_USDHC2_DATA1		0x0d6
			MX8MM_IOMUXC_SD2_DATA2_USDHC2_DATA2		0x0d6
			MX8MM_IOMUXC_SD2_DATA3_USDHC2_DATA3		0x0d6
			MX8MM_IOMUXC_GPIO1_IO04_USDHC2_VSELECT		0x0d0
		>;
	};

	pinctrl_usdhc3: usdhc3grp {
		fsl,pins = <
			MX8MM_IOMUXC_NAND_WE_B_USDHC3_CLK		0x00000016
			MX8MM_IOMUXC_NAND_WP_B_USDHC3_CMD		0x00000016
			MX8MM_IOMUXC_NAND_DATA04_USDHC3_DATA0		0x00000016
			MX8MM_IOMUXC_NAND_DATA05_USDHC3_DATA1		0x00000016
			MX8MM_IOMUXC_NAND_DATA06_USDHC3_DATA2		0x00000016
			MX8MM_IOMUXC_NAND_DATA07_USDHC3_DATA3		0x00000016
			MX8MM_IOMUXC_NAND_RE_B_USDHC3_DATA4		0x00000016
			MX8MM_IOMUXC_NAND_CE2_B_USDHC3_DATA5		0x00000016
			MX8MM_IOMUXC_NAND_CE3_B_USDHC3_DATA6		0x00000016
			MX8MM_IOMUXC_NAND_CLE_USDHC3_DATA7		0x00000016
			MX8MM_IOMUXC_NAND_CE1_B_USDHC3_STROBE		0x00000016
		>;
	};

	pinctrl_usdhc3_100mhz: usdhc3grp100mhz {
		fsl,pins = <
			MX8MM_IOMUXC_NAND_WE_B_USDHC3_CLK		0x00000016
			MX8MM_IOMUXC_NAND_WP_B_USDHC3_CMD		0x00000016
			MX8MM_IOMUXC_NAND_DATA04_USDHC3_DATA0		0x00000016
			MX8MM_IOMUXC_NAND_DATA05_USDHC3_DATA1		0x00000016
			MX8MM_IOMUXC_NAND_DATA06_USDHC3_DATA2		0x00000016
			MX8MM_IOMUXC_NAND_DATA07_USDHC3_DATA3		0x00000016
			MX8MM_IOMUXC_NAND_RE_B_USDHC3_DATA4		0x00000016
			MX8MM_IOMUXC_NAND_CE2_B_USDHC3_DATA5		0x00000016
			MX8MM_IOMUXC_NAND_CE3_B_USDHC3_DATA6		0x00000016
			MX8MM_IOMUXC_NAND_CLE_USDHC3_DATA7		0x00000016
			MX8MM_IOMUXC_NAND_CE1_B_USDHC3_STROBE		0x00000016
		>;
	};

	pinctrl_usdhc3_200mhz: usdhc3grp200mhz {
		fsl,pins = <
			MX8MM_IOMUXC_NAND_WE_B_USDHC3_CLK		0x00000016
			MX8MM_IOMUXC_NAND_WP_B_USDHC3_CMD		0x00000016
			MX8MM_IOMUXC_NAND_DATA04_USDHC3_DATA0		0x00000016
			MX8MM_IOMUXC_NAND_DATA05_USDHC3_DATA1		0x00000016
			MX8MM_IOMUXC_NAND_DATA06_USDHC3_DATA2		0x00000016
			MX8MM_IOMUXC_NAND_DATA07_USDHC3_DATA3		0x00000016
			MX8MM_IOMUXC_NAND_RE_B_USDHC3_DATA4		0x00000016
			MX8MM_IOMUXC_NAND_CE2_B_USDHC3_DATA5		0x00000016
			MX8MM_IOMUXC_NAND_CE3_B_USDHC3_DATA6		0x00000016
