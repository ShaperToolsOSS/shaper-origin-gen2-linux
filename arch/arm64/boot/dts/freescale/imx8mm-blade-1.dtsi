	pinctrl_wdog: wdoggrp {
		fsl,pins = <
			MX8MM_IOMUXC_GPIO1_IO02_WDOG1_WDOG_B		0x00000056
		>;
	};
};

&gpu {
	status = "okay";
	resets = <&src IMX8MQ_RESET_GPU_RESET>;
};
