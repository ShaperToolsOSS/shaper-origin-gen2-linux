	bt_dev_wake_gpio {
		/*
		 * BT_DEV_WAKE defaults high so userspace "hciattach ... nosleep" starts
		 * from a deterministic awake state without sysfs/gpio jiggling.
		 */
		gpio-hog;
		gpios = <7 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "bt_dev_wake";
	};

};

