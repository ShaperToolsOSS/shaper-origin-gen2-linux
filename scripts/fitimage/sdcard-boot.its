/dts-v1/;

/ {
	description = "Boot FitImage";
	#address-cells = <1>;

	images {
		boot-script {
			description = "Boot image script";
			data = /incbin/("sdcard-boot.ubs");
			type = "script";
			compression = "none";
			hash@1 {
				algo = "sha256";
			};
		};
		kernel {
			description = "Linux kernel";
			data = /incbin/("linux.bin");
			type = "kernel";
			arch = "arm64";
			os = "linux";
			compression = "zstd";
			load = <0x40480000>;
			entry = <0x40480000>;
			hash@1 {
				algo = "sha256";
			};
		};
		fdt {
			description = "Flattened Device Tree blob";
			data = /incbin/("linux.dtb");
			type = "flat_dt";
			arch = "arm64";
			compression = "zstd";
			load = <0x43000000>;
			hash@1 {
				algo = "sha256";
			};
		};
	};

	configurations {
		default = "boot-conf";
		boot-conf {
			description = "Boot Linux kernel with FDT blob";
			kernel = "kernel";
			fdt = "fdt";
			hash@1 {
				algo = "sha256";
			};
		};
	};
};
